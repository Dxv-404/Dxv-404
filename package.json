{
  "name": "train-poker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/web run build",
    "typecheck": "pnpm -r run typecheck && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.56.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.38.0",
    "fast-check": "4.3.0",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
