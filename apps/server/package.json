{
  "name": "@tp/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build:node": "esbuild src/node.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/node-server.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@tp/engine": "workspace:*",
    "@tp/protocol": "workspace:*",
    "ws": "8.18.3",
    "@tp/table": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.11",
    "wrangler": "4.156.0",
    "@tp/bots": "workspace:*"
  }
}
